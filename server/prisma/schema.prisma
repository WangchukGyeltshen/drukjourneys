// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TOURIST
  GUIDE
  AGENT
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  nationality   String?
  role          Role           @default(TOURIST)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  documents     Document[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum PackageCategory {
  CULTURAL
  TREKKING
  FESTIVAL
  PILGRIMAGE
  ADVENTURE
  WELLNESS
}

model Package {
  id                     String          @id @default(uuid())
  title                  String
  description            String
  dzongkhag              String
  category               PackageCategory
  durationDays           Int
  basePrice              Decimal         @db.Decimal(10, 2)
  currency               String          @default("USD")
  requiresSpecialPermit  Boolean         @default(false)
  imageUrl               String?
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  bookings               Booking[]

  @@index([isActive, createdAt])
  @@index([dzongkhag])
  @@index([category])
  @@map("packages")
}

enum DocumentType {
  PASSPORT
  VISA
  PERMIT
  PHOTO
  OTHER
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model Document {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType          DocumentType
  status           DocumentStatus @default(PENDING)
  storageKey       String         @unique
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime       @default(now())

  @@index([userId, uploadedAt])
  @@index([status, uploadedAt])
  @@map("documents")
}

enum DocumentAccessAction {
  DOWNLOAD
  STATUS_CHANGE
}

// Audit trail of STAFF access to travelers' documents (NFR-6). Owners
// reading their own files are not logged. The ids are deliberately plain
// strings, not foreign keys: the log must outlive the document or user it
// refers to, and must never be wiped by a cascade delete.
model DocumentAccessLog {
  id         String               @id @default(uuid())
  documentId String
  ownerId    String
  actorId    String
  actorRole  Role
  action     DocumentAccessAction
  newStatus  DocumentStatus?
  createdAt  DateTime             @default(now())

  @@index([documentId, createdAt])
  @@index([actorId, createdAt])
  @@map("document_access_logs")
}

enum BookingStatus {
  DRAFT
  SDF_CALCULATED
  GUIDE_ASSIGNED
  CONFIRMED
  CANCELLED
}

model Booking {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String
  package        Package         @relation(fields: [packageId], references: [id])
  status         BookingStatus   @default(DRAFT)
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  travelerCount  Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sdfRecord       SdfRecord?
  guideAssignment GuideAssignment?
  payment         Payment?
  review          Review?

  @@index([userId, createdAt])
  @@index([packageId])
  @@index([status])
  @@map("bookings")
}

enum TravelerCategory {
  INTERNATIONAL
  INDIAN
  BANGLADESHI
  MALDIVIAN
  DOMESTIC
}

model SdfRecord {
  id               String           @id @default(uuid())
  bookingId        String           @unique
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerCategory TravelerCategory
  nights           Int
  ratePerNight     Decimal          @db.Decimal(10, 2)
  totalSdf         Decimal          @db.Decimal(10, 2)
  currency         String
  createdAt        DateTime         @default(now())

  @@map("sdf_records")
}

enum GuideStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
}

model Guide {
  id             String            @id @default(uuid())
  name           String
  licenseNumber  String            @unique
  status         GuideStatus       @default(AVAILABLE)
  createdAt      DateTime          @default(now())

  assignments    GuideAssignment[]

  @@map("guides")
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
}

model Vehicle {
  id            String            @id @default(uuid())
  plateNumber   String            @unique
  type          String
  status        VehicleStatus     @default(AVAILABLE)
  createdAt     DateTime          @default(now())

  assignments   GuideAssignment[]

  @@map("vehicles")
}

model GuideAssignment {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guideId    String
  guide      Guide    @relation(fields: [guideId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  assignedAt DateTime @default(now())

  @@index([guideId])
  @@index([vehicleId])
  @@map("guide_assignments")
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

model Review {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Package rating is required — every CONFIRMED booking has a package.
  // Guide rating is optional: even though a CONFIRMED booking always has
  // a guide assigned by the time it reaches this status, a traveler may
  // not want to rate the guide specifically, only the trip overall.
  packageRating  Int
  packageComment String?
  guideRating    Int?
  guideComment   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("reviews")
}

model FaqEntry {
  id        String   @id @default(uuid())
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_entries")
}

enum SupportInquiryStatus {
  OPEN
  RESOLVED
}

model SupportInquiry {
  id        String               @id @default(uuid())
  name      String
  email     String
  message   String
  status    SupportInquiryStatus @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([createdAt])
  @@map("support_inquiries")
}

enum NotificationType {
  SDF_CALCULATED
  GUIDE_ASSIGNED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
}

enum NotificationStatus {
  SENT
  FAILED
}

model Notification {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId        String?
  type             NotificationType
  channel          String             @default("EMAIL")
  recipientAddress String
  subject          String
  status           NotificationStatus
  errorMessage     String?
  createdAt        DateTime           @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("notifications")
}
